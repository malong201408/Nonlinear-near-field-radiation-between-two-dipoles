(*Constants*)
hbar = 6.582119569*10^-16;(*eV\[CenterDot]s*)
kB = 8.6173303*10^-5;(*eV/K*)
c = 3*10^18;(*Å/s*)
\[CurlyEpsilon]0 = 1/(4*\[Pi]);(*in CGS units *)
T1 = 300;(*K*)
T2 = 400;(*K*)


(*chemical: 4-Dimethylamino-4'-nitrostilbene*)
axx = 53; (*in Å^3*)
ayy = 19; (*in Å^3*)
EffR = (axx/(2*\[Pi]*\[CurlyEpsilon]0))^(1/3);
A = {{axx, 0, 0}, {0, ayy, 0}, {0, 0, 0}} (* in CGS units*);
Atilde = A/EffR^3;
\[Omega]0 = 
  2.9/hbar;(*\[Omega]0 in s^-1 from \[HBar]\[Omega]0=2.9 eV*)
\[Eta] = 0.01/
   hbar;(*damping in s⁻¹*)(*Convergence test for different \[Eta] is \
necessary*)

(*Normalize frequency \[Omega]n=\[Omega]/\[Omega]0;*)

(*Normalized postion*)
r1n = {0, 0, 0};
r2n[r2_?NumericQ] := {r2/EffR, 0, 
   0};(* r2=r2n*EffR,so physical r2={EffR,0,0} Å, This is in CGS \
units*)
r2List = Join[Table[10^i, {i, Log10[5], 1 - 1/50, 1/50}], 
   Table[10^i, {i, 1, 4, 1/50}]];

(*Free-space Green's tensor G12^0(r1n,r2n,\[Omega])*)
(*Note:the document uses the form below*)(*Following the exact \
expression from the document:G12^0=(e^{ikR}/(4\[Pi]R))*{(1+ikR-1/(k\
\.b2R\.b2))*I+(3/(k\.b2R\.b2)-3ikR-1)*R̂\[CircleTimes]R̂} Rewritten \
cleanly:*)

G12free[r1n_List, r2n_List, \[Omega]n_] := 
  Module[{Rvec, R, ktilde, Rhat, RR}, Rvec = r1n - r2n;
   R = Norm[Rvec];
   ktilde = (\[Omega]0*EffR)/c*\[Omega]n;(*normalized k*)
   Rhat = Rvec/R;
   RR = Outer[Times, Rhat, Rhat];(*R̂\[CircleTimes]R̂*)
   (Exp[I ktilde R]/(4 \[Pi] R*
        EffR))*((1 + (I ktilde R - 1)/((ktilde)^2 (R)^2))*
       IdentityMatrix[3] + ((
        3*(1 - I*ktilde R) - (ktilde)^2 (R)^2)/((ktilde)^2 (R)^2))*
       RR)];

(*T12 tensor*)
T12[r1n_List, r2n_List, \[Omega]n_] := 
  Module[{k2tilde}, 
   k2tilde = (\[Omega]0^2*\[Omega]n^2)/c^2*EffR^2;(*normalized k^2*)
   (k2tilde/\[CurlyEpsilon]0)*G12free[r1n, r2n, \[Omega]n]];

(*POLARIZABILITY TENSOR \[Alpha](\[Omega])\[LongDash]3x3 tensor with \
normalized A tensor*)
 \[Alpha][\[Omega]n_] := 
  Atilde*(1/(1 - \[Omega]n^2 - I*\[Eta]*\[Omega]n/\[Omega]0));

(*P^{-1}TENSOR*)
Pinv[r1n_List, r2n_List, \[Omega]n_] := Module[{II, T, Alph, M},
   II = IdentityMatrix[3];
   T = T12[r1n, r2n, \[Omega]n];(*3x3 tensor*)
   Alph = \[Alpha][\[Omega]n];(*3x3 tensor*)
   M = II - (T . Alph . T . Alph);(*I-
   T12\[CenterDot]\[Alpha]\[CenterDot]T12\[CenterDot]\[Alpha]*)
   Inverse[M]                         (*(I-
   T12\[CenterDot]\[Alpha]\[CenterDot]T12\[CenterDot]\[Alpha])^{-1}*)];

(*BOSE-EINSTEIN DISTRIBUTIONS
n1(\[Omega],T1)=1/(exp(ħ\[Omega]/kB T1)-1)
n2(\[Omega],T2)=1/(exp(ħ\[Omega]/kB T2)-1)*)
n1[\[Omega]n_] := 1/(Exp[(hbar*\[Omega]n*\[Omega]0)/(kB*T1)] - 1);
n2[\[Omega]n_] := 1/(Exp[(hbar*\[Omega]n*\[Omega]0)/(kB*T2)] - 1); 
deltaN[\[Omega]n_] := n2[\[Omega]n] - n1[\[Omega]n];

(*INTEGRAND OF Q12*)
integrandQ12[r1n_List, r2n_List, \[Omega]n_] := 
  Module[{Pv, T, Tc, Pvc, ImAlph, mat},
   Pv = Pinv[r1n, r2n, \[Omega]n];(*P^{-1}*)
   Pvc = ConjugateTranspose[Pv];(*P^{-1\[Dagger]}*)
   T = T12[r1n, r2n, \[Omega]n];(*T12*)
   Tc = ConjugateTranspose[T];(*T12\[Dagger]*)
   ImAlph = Im[\[Alpha][\[Omega]n]];(*Im[\[Alpha]] 3x3*)
   
   (*[P^{-1}.T12.T12\[Dagger].P^{-1\[Dagger]}]*)
   mat = Pv . T . Tc . Pvc;
   
   \[Omega]0*(hbar*\[Omega]n*\[Omega]0)/(2 \[Pi])*(4 \[Pi])*
    deltaN[\[Omega]n]*Tr[ImAlph . ImAlph]*Tr[mat]    ];

\[Omega]nmin = 0;
(*\[Omega]nmin=0.01/(\[Omega]0*hbar);*)

(*\[HBar]\[Omega]=0.01 eV\[LongDash]avoid \[Omega]=0 singularity*)
Q12[r2_?NumericQ] := 
  NIntegrate[
   integrandQ12[r1n, r2n[r2], \[Omega]n], {\[Omega]n, \[Omega]nmin, 
    Infinity},(*\[Omega]0 as breakpoint,\[Infinity] upper limit*) 
   Method -> {"GlobalAdaptive", "SingularityHandler" -> "IMT" }, 
   AccuracyGoal -> 4, PrecisionGoal -> 4, MaxRecursion -> 100];
Q12List = Table[{r2, Q12[r2]}, {r2, r2List}];
