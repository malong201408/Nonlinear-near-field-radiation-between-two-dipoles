Cell["\<\
a2xx=53;(*Angstrom^3*)
a2yy=0;
a2xy=0;
a2yx=a2xy;(*axy=ayx* in the calcuation*)\
\>", "Input",
 CellChangeTimes->{{3.99484451025883*^9, 3.9948445151612597`*^9}, {
