Cell["\<\
(* ===========================================================================\
= *)
(*  (The GLOBAL COLORBAR CONTROL PANEL was removed together with the integL12 \
/  *)
(*   integNL12 heat-map code; those signed-log colorbar settings are no \
longer   *)
(*   used.  This build exports only the Q-vs-R curves and the Q-vs-R \
temperature *)
(*   sweep.)                                                                  \
   *)
(* ===========================================================================\
= *)\
\>", "Input",
 CellLabel->"In[52]:=",ExpressionUUID->"4e90e8a5-1e43-4e70-af38-85407f95d631"],

Cell["\<\
(* ================================================================*)
(*SECTION 1:Physical constants*)
(* ================================================================*)\
\>", "Input",
 CellLabel->"In[58]:=",ExpressionUUID->"1fe23b45-d253-41af-b4c9-644c566f2a46"],

Cell["\<\
hbar=6.582119569*^-16;(*eV s*)
kB=8.6173303*^-5;(*eV/K*)
c=3.0*^18;(*Angstrom/s*)
eps0=1/(4 Pi);(*CGS units*)
(**both eps0SI and ESU are needed to fix the dimension mismatch between code \
and the paper **)
eps0SI=0.005526349406;(*e/(V A)*)
ESU=2.99792458*10^-6;(*V/A*)
T1=50;(*K,cold body*)
T2=400;(*K,hot body*)\
\>", "Input",
 CellChangeTimes->{{3.995099032647525*^9, 3.9950990338381176`*^9}, {
  3.9986477159027243`*^9, 3.998647717076136*^9}, {3.9986486216469517`*^9, 
  3.998648621759152*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"61a40613-e8c8-4856-bf24-d825be4fcf84"],

Cell["\<\
(* ================================================================*)
(*SECTION 2:Molecular parameters *)
(* ================================================================*)\
\>", "Input",
 CellLabel->"In[70]:=",ExpressionUUID->"19ff91df-c8ee-4f17-b3a2-612480fc269f"],

Cell["\<\
(* dipole 1 and 2 can not be the same *)
(*alpha tensor*)
a1xx=53;(*Angstrom^3*)
a1yy=0;
a1xy=0;
a1yx=a1xy;(*axy=ayx* in the calcuation*)\
\>", "Input",
 CellChangeTimes->{{3.994844494101428*^9, 3.994844505627946*^9}, {
  3.995035414556295*^9, 3.9950354217530403`*^9}, {3.995359359819497*^9, 
