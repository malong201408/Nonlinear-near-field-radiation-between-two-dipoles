Cell["\<\
(* ============================================================ *)
(*  NOTE ON THE SYMMETRY ASSIGNMENT a2yx = a2xy                 *)
(*                                                              *)
(*  In the original notebook a1yx/a2yx are set equal to        *)
(*  a1xy/a2xy BEFORE alphaTensor is built. After rotation the   *)
(*  off-diagonal entries mix, so that equality no longer holds  *)
(*  in the rotated frame \[LongDash] which is physically correct: a       *)
(*  rotated tensor generally has a'_xy != a'_yx unless the      *)
(*  original was symmetric. If you specifically NEED the        *)
(*  rotated tensor to stay symmetric, the ORIGINAL must be      *)
(*  symmetric (a_xy = a_yx); rotation then preserves symmetry.  *)
(* ============================================================ *)\
\>", "Input",
 CellLabel->
  "In[149]:=",ExpressionUUID->"779fbd76-fae3-4b77-afed-5ad2f2f6689f"],

Cell["(*anisotropic parameter for dipole 1 and 2*)", "Input",
 CellLabel->
  "In[161]:=",ExpressionUUID->"879bf1b1-42fb-4589-9d03-de42dfc62d2a"],

Cell["\<\
(*xi1=1-a1yy/a1xx;
xi2=1-a2yy/a2xx;*)
xi1=0;
xi2=0;\
\>", "Input",
 CellLabel->
  "In[162]:=",ExpressionUUID->"af0a9631-4c2f-4975-af81-e07bc2f73e1f"],

Cell["\<\
(*characteristic frequencies \[Omega]0 for dipole 1 and 2*)
om001=2.9/hbar;(*rad/s from https://spectrabase.com/spectrum/22P2T1TA9gG*)
om002=2.9/hbar;(*rad/s*)
omR=om002/om001;
om01=1;(*rad/s*)
om02=omR;(*rad/s*)\
\>", "Input",
 CellChangeTimes->{{3.995035643089089*^9, 3.9950356445481977`*^9}, 
   3.9951036651245193`*^9, {3.995115694139988*^9, 3.995115702372515*^9}, {
   3.995359564927734*^9, 3.9953595695546603`*^9}, {3.99536248946278*^9, 
   3.995362495926157*^9}, {3.9986420268787937`*^9, 3.9986420323201094`*^9}},
 CellLabel->
  "In[165]:=",ExpressionUUID->"8b6935c9-97ec-45ed-b074-8c67d7f20dde"],

Cell["\<\
(*Effective radius R and normalized parameter B for dipole 1 and 2*)
EffR1=(a1xx/(2*\[Pi]*eps0))^(1/3);(*Angstrom*)
EffB1=(4*\[Pi]*eps0SI)^(1/2)*(a1xx*(1-xi1))^(3/2)/(hbar*om001*om01)^(1/2);\
\>", "Input",
 CellLabel->
  "In[171]:=",ExpressionUUID->"374f4f02-e058-400e-b5ec-38232bac3942"],

Cell["\<\
EffR2=(a2xx/(2*\[Pi]*eps0))^(1/3);(*Angstrom*)
EffB2=(4*\[Pi]*eps0SI)^(1/2)*(a2xx*(1-xi2))^(3/2)/(hbar*om001*om02)^(1/2);\
\>", "Input",
 CellLabel->
  "In[174]:=",ExpressionUUID->"94fac393-bbf9-4ac3-bd75-24376909988d"],

Cell["(*Normalized alpha and beta tensor for dipole 1 and 2*)", "Input",
 CellLabel->
  "In[176]:=",ExpressionUUID->"abc0ffbd-78a1-42ea-904b-6988618185ea"],

Cell["\<\
Atilde1=alphaTensor1/((2*\[Pi]*eps0)*(EffR1^3));
Atilde2=alphaTensor2/((2*\[Pi]*eps0)*(EffR2^3));\
\>", "Input",
 CellLabel->
  "In[177]:=",ExpressionUUID->"4c7c6e9b-4e1d-4163-9c71-56720f135847"],

Cell["\<\
Btilde1=ESU*betaTensor1/EffB1;
Btilde2=ESU*betaTensor2/EffB2;\
\>", "Input",
 CellChangeTimes->{{3.9986481691018925`*^9, 3.9986481708828263`*^9}},
 CellLabel->
  "In[179]:=",ExpressionUUID->"c8080caf-df37-453f-a0f9-a08ea3ecbb01"],

Cell[CellGroupData[{

Cell[BoxData["Btilde1"], "Input",
 CellChangeTimes->{{3.9986481423519297`*^9, 3.9986481648707256`*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"6a5ab0e7-fb34-4014-b5da-cfbe20c6c531"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "0.000012552256467810748`"}], ",", "0.`", ",", "0.`"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0.`", ",", "0.`", ",", "0.`"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.998648323484284*^9, 3.9986526211073837`*^9, 
  3.998660908501147*^9, 3.998661848589788*^9, 3.9987372322941847`*^9, 
  3.998744516208598*^9, 3.9990751596953406`*^9, 3.9990753853510313`*^9, 
  3.999097952896299*^9, 3.999596477485575*^9, 4.000303444023326*^9},
 CellLabel->
  "Out[181]=",ExpressionUUID->"b9e60ed4-620b-4e4e-a83e-2f3841d05485"]
}, Open  ]],

Cell["(*dimensionless reference wave-vector for dipole 1 and 2*)", "Input",
 CellLabel->
  "In[182]:=",ExpressionUUID->"02f3eec8-b99a-45f0-a4c1-cc50c36dc985"],

Cell["\<\
k01=om001*om01*EffR1/c;
k02=om001*om02*EffR2/c;\
\>", "Input",
 CellLabel->
  "In[183]:=",ExpressionUUID->"0b7c881a-fd99-4ddd-9549-9184a85fa68c"],

Cell["\<\
(* ================================================================*)
(*SECTION 3:Scalar Lorentzians*)(**)(*All tensor quantities factor as \
(scalar) x (fixed tensor).*)(*lor[w] is the only frequency-dependent \
piece.*)(* ================================================================*)
(*was eta1=0.03/hbar;*)
(*was eta2=0.03/hbar;*)
eta1=0.015*om001;
eta2=0.015*om002;\
\>", "Input",
 CellChangeTimes->{{3.9987370105402274`*^9, 3.998737014957209*^9}, {
  3.9987389671623373`*^9, 3.998738971876541*^9}, {3.99874429971904*^9, 
  3.9987443047367754`*^9}, {3.998745820461629*^9, 3.998745902068952*^9}, {
  3.999097874381359*^9, 3.999097876666181*^9}},
 CellLabel->
  "In[185]:=",ExpressionUUID->"92a27c4d-3be0-4cf8-ae34-867cb448facf"],

Cell["\<\
lor1[w_]:=1/(1-w^2-I*eta1*(w/om001*om01));
lor2[w_]:=1/(1-w^2-I*eta2*(w/om001*om02));\
\>", "Input",
 CellLabel->
  "In[191]:=",ExpressionUUID->"1fd3ed9c-c4d5-4444-9ebb-df9d355840dc"],

Cell["\<\
(*Full polarisability tensor*)
alphaTens1[w_]:=Atilde1*lor1[w];
alphaTens2[w_]:=Atilde2*lor2[w];\
\>", "Input",
 CellLabel->
  "In[193]:=",ExpressionUUID->"46b4b8c0-8544-48cf-bc61-9ff0c91651d0"],

Cell["\<\
(*Hyperpolarisability scalars *)
s1B12[w_,w1_]:=Btilde1*lor1[w]*lor1[w1]*lor1[w-w1]; (*w1,w2*)
s1B2N0[w_,w1_]:=Btilde1*lor1[-w1]*lor1[w-w1]*lor1[-w];(*w2,-w*)
s1B1N0[w_,w1_]:=Btilde1*lor1[-(w-w1)]*lor1[w1]*lor1[-w];(*w1,-w*)\
\>", "Input",
 CellLabel->
  "In[196]:=",ExpressionUUID->"5661641d-1518-4db3-9b8e-fbe9b61211b8"],

Cell["\<\
s2B12[w_,w1_]:=Btilde2*lor2[w]*lor2[w1]*lor2[w-w1];
s2B2N0[w_,w1_]:=Btilde2*lor2[-w1]*lor2[w-w1]*lor2[-w];
s2B1N0[w_,w1_]:=Btilde2*lor2[-(w-w1)]*lor2[w1]*lor2[-w];\
\>", "Input",
 CellLabel->
  "In[200]:=",ExpressionUUID->"2dc7c597-2a85-4cd2-a5c1-a6bbc0d6b571"],

Cell["\<\
(* ================================================================*)
(*SECTION 4:Geometry (separation-dependent,frequency-free)*)
(* ================================================================*)\
\>", "Input",
 CellLabel->
  "In[203]:=",ExpressionUUID->"9a67d100-c901-4376-a3e6-94fb04115ce7"],

Cell["\<\
r1n={0,0,0};
r2n[r2_?NumericQ]:={r2,0,0};\
\>", "Input",
 CellLabel->
  "In[206]:=",ExpressionUUID->"9e307f6a-72cb-42ca-92c7-b61cc64a3769"],

Cell["\<\
(*Returns {Rn,RRmat}-- call once per r2,reuse for all frequencies*)
(*Note that r1 and r2 are  the normalized distance*)
(*G12=G21 so that they share the same geometry tensor*)
geoData[r2_?NumericQ]:=Module[{Rvec,Rn,Rhat},Rvec=r1n-r2n[r2];
Rn=Norm[Rvec];
Rhat=Rvec/Rn;
{Rn,Outer[Times,Rhat,Rhat]}];\
\>", "Input",
 CellLabel->
  "In[208]:=",ExpressionUUID->"8ee6a0c0-10b5-46fc-a970-c0b5b4f866da"],

Cell["\<\
(* ================================================================*)
(*SECTION 5:Free-space Interaction tensor T0(w) (normalized)*)
(* ================================================================*)\
\>", "Input",
 CellLabel->
  "In[212]:=",ExpressionUUID->"73ec33b8-ff6b-48af-b576-e97f0e6263a4"],

Cell["\<\
(*Note that Tn12 and Tn21 are different only on dimensionless wave-vector k01 \
and k02*)
(*8 instead of 4 to normalized with respect to 1/R^3 not 2/R^3*)
Tn12[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{kn1,knRn1,phase1,II},
kn1=k01*w;(*real*)
knRn1=kn1*Rn;(*real*)
phase1=Exp[I*knRn1];(*complex,magnitude 1*)
II=IdentityMatrix[3];
(phase1/(8*\[Pi]*eps0*Rn^3))*((knRn1^2+(I*knRn1-1))*II+(3*(1-I*knRn1)-knRn1^2)\
*RRmat)];\
\>", "Input",
 CellLabel->
  "In[215]:=",ExpressionUUID->"18031406-b653-440b-9fc9-76b13ab745c2"],

Cell["\<\
Tn21[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{kn2,knRn2,phase2,II},
kn2=k02*w;(*real*)
knRn2=kn2*Rn;(*real*)
phase2=Exp[I*knRn2];(*complex,magnitude 1*)
II=IdentityMatrix[3];
(phase2/(8*\[Pi]*eps0*Rn^3))*((knRn2^2+(I*knRn2-1))*II+(3*(1-I*knRn2)-knRn2^2)\
*RRmat)];\
\>", "Input",
 CellLabel->
  "In[218]:=",ExpressionUUID->"4dfc81d6-1bad-4fcd-8c9b-f170d9ebad42"],

Cell["\<\
(* ================================================================*)
(*SECTION 6:P^{-1}(w) different by P12 and P21*)
(* ================================================================*)\
\>", "Input",
 CellLabel->
  "In[219]:=",ExpressionUUID->"8684d0d7-966e-4e7c-bd26-c550211654b5"],

Cell["\<\
(* P12 = I - T12 a2 T21 a1 ,  P21 = I - T21 a1 T12 a2   (notes, below Eq. 23) \
*)
Pinv[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{Tens12,Al2,Tens21,Al1},
Tens12=Tn12[w,Rn,RRmat];
Al2=alphaTens2[w];
Tens21=Tn21[w,Rn,RRmat];
Al1=alphaTens1[w];
Inverse[IdentityMatrix[3]-Tens12 . Al2 . Tens21 . Al1]];   (* = P12^{-1} *)

Pinv21[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{Tens12,Al2,Tens21,Al1},
Tens12=Tn12[w,Rn,RRmat];
Al2=alphaTens2[w];
Tens21=Tn21[w,Rn,RRmat];
Al1=alphaTens1[w];
Inverse[IdentityMatrix[3]-Tens21 . Al1 . Tens12 . Al2]];   (* = P21^{-1} *)\
\>", "Input",
 CellLabel->
  "In[222]:=",ExpressionUUID->"aa93d8ae-ab92-4433-9cad-1623d088a4dc"],

Cell["\<\
(* ================================================================*)
(*SECTION 6:A11 A12 A21 A22*)
(* ================================================================*)
A11[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{Tens12,Al2,PinM,Tens21},
Tens12=Tn12[w,Rn,RRmat];
Al2=alphaTens2[w];
PinM=Pinv21[w,Rn,RRmat];   (* [F1] notes Eq. 20 *)
Tens21=Tn21[w,Rn,RRmat];
Tens12 . Al2 . PinM . Tens21];\
\>", "Input",
 CellLabel->
  "In[226]:=",ExpressionUUID->"aa37029c-7822-4f43-8396-2ef88c611eb1"],

Cell["\<\
A12[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{Tens12,PinM},
Tens12=Tn12[w,Rn,RRmat];
PinM=Pinv[w,Rn,RRmat];
PinM . Tens12];\
\>", "Input",
 CellLabel->
  "In[230]:=",ExpressionUUID->"5fbd7c38-264d-4137-aca9-77722ec79b9e"],

Cell["\<\
A21[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{Tens21,PinM},
Tens21=Tn21[w,Rn,RRmat];
PinM=Pinv21[w,Rn,RRmat];   (* [F1] notes Eq. 22 *)
PinM . Tens21];\
\>", "Input",
 CellLabel->
  "In[231]:=",ExpressionUUID->"9c214611-07c4-4895-8ee0-4fbf2aecaa5c"],

Cell["\<\
A22[w_?NumericQ,Rn_?NumericQ,RRmat_List]:=Module[{Tens21,Al1,PinM,Tens12},
Tens21=Tn21[w,Rn,RRmat];
Al1=alphaTens1[w];
PinM=Pinv[w,Rn,RRmat];
Tens12=Tn12[w,Rn,RRmat];
Tens21 . Al1 . PinM . Tens12];\
\>", "Input",
 CellLabel->
  "In[232]:=",ExpressionUUID->"e608ecb2-a665-4eb3-9d95-138107b5aa14"],

Cell["\<\
(* ================================================================*)
(*SECTION 7:M111, M112, M221, M222*)
(* ================================================================*)\
\>", "Input",
 CellLabel->
  "In[233]:=",ExpressionUUID->"949b15a8-c115-4877-ae4f-6b0edb730ca4"],

Cell["(*M tensors:beta tensor contracted with A11 A12 A21 A22 *)", "Input",
 CellLabel->
  "In[236]:=",ExpressionUUID->"8ea36fca-d4c2-49f2-909f-7010d3a7630d"],

Cell["\<\
M111[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,beta1, \
Atens11om1, Atens11om2},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
beta1=s1B12[w,w1];
Atens11om1=A11[w1,Rn,RRmat];
Atens11om2=A11[w2,Rn,RRmat];
TensorContract[TensorProduct[beta1,Atens11om1,Atens11om2],{{2,4},{3,6}}]];\
\>", "Input",
 CellLabel->
  "In[237]:=",ExpressionUUID->"680bc174-c62a-4d91-8f9f-4a50af4e344f"],

Cell["\<\
M112[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,beta1, \
Atens12om1, Atens12om2},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
beta1=s1B12[w,w1];
Atens12om1=A12[w1,Rn,RRmat];
Atens12om2=A12[w2,Rn,RRmat];
TensorContract[TensorProduct[beta1,Atens12om1,Atens12om2],{{2,4},{3,6}}]];\
\>", "Input",
 CellLabel->
  "In[238]:=",ExpressionUUID->"e67d89b3-cd85-46a5-8b4f-dd7910c3ecac"],

Cell["\<\
M221[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,beta2, \
Atens21om1, Atens21om2},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
beta2=s2B12[w,w1];
Atens21om1=A21[w1,Rn,RRmat];
Atens21om2=A21[w2,Rn,RRmat];
TensorContract[TensorProduct[beta2,Atens21om1,Atens21om2],{{2,4},{3,6}}]];\
\>", "Input",
 CellLabel->
  "In[239]:=",ExpressionUUID->"9bae8b5a-8bc5-40db-8ce8-1a2ee211c985"],

Cell["\<\
M222[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,beta2, \
Atens22om1, Atens22om2},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
beta2=s2B12[w,w1];
Atens22om1=A22[w1,Rn,RRmat];
Atens22om2=A22[w2,Rn,RRmat];
TensorContract[TensorProduct[beta2,Atens22om1,Atens22om2],{{2,4},{3,6}}]];\
\>", "Input",
 CellLabel->
  "In[240]:=",ExpressionUUID->"ccfc244e-6cdb-4c43-bbc6-01ee87a7d39e"],

Cell["\<\
(* ================================================================*)
(*SECTION 8: B tensors: B11, B12, B21, B22*)
(* ================================================================*)
B11[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,Tens12, \
Tens21, Al1,Al2,  PinvM,Mtens221, Mtens111},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
(*T matrix*)
Tens12=Tn12[w,Rn,RRmat];
Tens21=Tn21[w,Rn,RRmat];
(*alpha matrix*)
Al1=alphaTens1[w];
Al2=alphaTens2[w];
(*Pinv matrix*)
 PinvM=Pinv[w,Rn,RRmat];
(*M matrix*)
Mtens221=M221[r2,w,w1];
Mtens111=M111[r2,w,w1];
Tens12 . Al2 . Pinv21[w,Rn,RRmat] . (Tens21 . Al1 . Tens12 . Mtens221+Tens21 \
. Mtens111)+Tens12 . Mtens221];   (* [F1] notes Eq. 26 *)\
\>", "Input",
 CellLabel->
  "In[241]:=",ExpressionUUID->"3fae9be6-18dd-4376-83d4-9b000bf8d4a8"],

Cell["\<\
B12[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,Tens12, \
Tens21, Al2,  PinvM,Mtens112, Mtens222},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
(*T matrix*)
Tens12=Tn12[w,Rn,RRmat];
Tens21=Tn21[w,Rn,RRmat];
(*alpha matrix*)
Al2=alphaTens2[w];
(*Pinv matrix*)
 PinvM=Pinv[w,Rn,RRmat];
(*M matrix*)
Mtens112=M112[r2,w,w1];
Mtens222=M222[r2,w,w1];
PinvM . (Tens12 . Al2 . Tens21 . Mtens112+Tens12 . Mtens222)];\
\>", "Input",
 CellLabel->
  "In[245]:=",ExpressionUUID->"0cbf56ef-031d-4221-a143-814ca9326480"],

Cell["\<\
B21[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,Tens12, \
Tens21, Al1,  PinvM,Mtens221, Mtens111},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
(*T matrix*)
Tens12=Tn12[w,Rn,RRmat];
Tens21=Tn21[w,Rn,RRmat];
(*alpha matrix*)
Al1=alphaTens1[w];
(*Pinv matrix*)
 PinvM=Pinv[w,Rn,RRmat];
(*M matrix*)
Mtens221=M221[r2,w,w1];
Mtens111=M111[r2,w,w1];
Pinv21[w,Rn,RRmat] . (Tens21 . Al1 . Tens12 . Mtens221+Tens21 . Mtens111)];   \
(* [F1] notes Eq. 28 *)\
\>", "Input",
 CellLabel->
  "In[246]:=",ExpressionUUID->"c6e7a336-bfbf-4057-a681-0e9dd72537a9"],

Cell["\<\
B22[r2_?NumericQ,w_?NumericQ,w1_?NumericQ]:=Module[{w2,Rn,RRmat,Tens12, \
Tens21, Al1,Al2,  PinvM,Mtens112, Mtens222},
w2=w-w1;
{Rn,RRmat}=geoData[r2];
(*T matrix*)
Tens12=Tn12[w,Rn,RRmat];
Tens21=Tn21[w,Rn,RRmat];
(*alpha matrix*)
Al1=alphaTens1[w];
Al2=alphaTens2[w];
(*Pinv matrix*)
 PinvM=Pinv[w,Rn,RRmat];
(*M matrix*)
Mtens112=M112[r2,w,w1];
Mtens222=M222[r2,w,w1];
Tens21 . Al1 . PinvM . (Tens12 . Al2 . Tens21 . Mtens112+Tens12 . \
Mtens222)+Tens21 . Mtens112];\
\>", "Input",
 CellLabel->
  "In[247]:=",ExpressionUUID->"bd47d791-5e7e-4cf0-bb9f-111f5727061b"],

Cell["\<\
(* ================================================================*)
(*SECTION 9:Core integrand for linear heat transfer*)
(*Note that this is only for radiation from particle 1 to particle 2*)
(*The exchange power should be the substraction between integLinear1 and \
integLinear2*)
(* ================================================================*)
CothSafe[x_?NumericQ]:=If[Abs[x]<1*^-8,1/x,Coth[x]];
(*CothSafe[x_]:=If[Abs[x]<1*^-10,ComplexInfinity,Coth[x]];*)\
\>", "Input",
 CellLabel->
  "In[248]:=",ExpressionUUID->"c2af7d36-0e23-471e-967d-97be9b880e2c"],

Cell["\<\
integL12[r2_?NumericQ,w_?NumericQ,temp1_?NumericQ,temp2_?NumericQ]:=Module[{\
Rn,RRmat,Al1, Al2,  Atens11,Atens12,Atens21,Atens22, \
DagAtens11,DagAtens12,DagAtens21, DagAtens22, ImAl1,ImAl2, II,Ggeo11,Ggeo12, \
Ggeo21,Ggeo22},
{Rn,RRmat}=geoData[r2];
Al1=alphaTens1[w];
Al2=alphaTens2[w];

Atens11=A11[w,Rn,RRmat];
Atens12=A12[w,Rn,RRmat];
Atens21=A21[w,Rn,RRmat];
Atens22=A22[w,Rn,RRmat];

DagAtens11=Conjugate[Transpose[Atens11,{2,1}]];
DagAtens12=Conjugate[Transpose[Atens12,{2,1}]];
DagAtens21=Conjugate[Transpose[Atens21,{2,1}]];
DagAtens22=Conjugate[Transpose[Atens22,{2,1}]];

ImAl1=Im[Al1];
ImAl2=Im[Al2];
(*PP1=2*\[Pi]*ImAl1*Coth[(((hbar*om001*om01*w))/(2*(kB*temp1)))];*)(*linear \
fluctuation-dissipation \
theorem*)(*(((2)/(Exp[(((hbar*om01*w))/((kB*temp1)))]))+1)*)(*Coth[(((hbar*\
om01*w))/(2*(kB*temp1)))]*)
(*PP2=2*\[Pi]*ImAl2*Coth[(((hbar*om001*om02*w))/(2*(kB*temp2)))];*)(*linear \
fluctuation-dissipation \
theorem*)(*(((2)/(Exp[(((hbar*om02*w))/((kB*temp2)))]))+1)*)(*Coth[(((hbar*\
om02*w))/(2*(kB*temp2)))]*)
II=IdentityMatrix[3];

(*terms wrt T1 and T2 are regrouped and substracted in between QL1->2 and \
QL2->1*)
Ggeo11=om01^2*Tr[Im[(II+Al1 . Atens11) . ImAl1 . DagAtens11]];
Ggeo12=om01^2*Tr[Im[(Al1 . Atens12) . ImAl2 . DagAtens12]];
Ggeo21=om02^2*Tr[Im[(II+Al2 . Atens22) . ImAl2 . DagAtens22]];
Ggeo22=om02^2*Tr[Im[(Al2 . Atens21) . ImAl1 . DagAtens21]];
w*(Ggeo11*CothSafe[hbar*om001*om01*w/(2*kB*temp1)]
+Ggeo12*CothSafe[hbar*om001*om01*w/(2*kB*temp2)]
-Ggeo21*CothSafe[hbar*om001*om02*w/(2*kB*temp2)]
-Ggeo22*CothSafe[hbar*om001*om02*w/(2*kB*temp1)])
];\
\>", "Input",
 CellLabel->
  "In[255]:=",ExpressionUUID->"a2a9ccec-9595-436d-bffd-35bd3ef2f830"],

Cell["\<\
(* ================================================================*)
(*SECTION 10:Core integrand for nonlinear and nonlinear heat transfer*)
(*Note that this is only for radiation from particle 1 to particle 2*)
(*The exchange power should be the substraction between integLinear1 and \
integLinear2*)
(* ================================================================*)\
\>", "Input",
 CellLabel->
  "In[256]:=",ExpressionUUID->"fc9e3a5f-47eb-4e92-a1a3-fadae41df302"],

Cell["\<\
(*Generic contraction:ContractTerm[Tleft,Btensor,ppp,Aright]; 
Tleft:3x3 matrix (e.g.T21^{-1});
Btensor:3x3x3 tensor (j,k,l indices) ;
ppp:3x3x3 tensor (k,l,m indices\[LongDash]the triple correlator);
Aright:3x3 matrix (conjugate,m,n indices) ;
Output:3x3 matrix C_{i,n}*)\
\>", "Input",
 CellLabel->
  "In[261]:=",ExpressionUUID->"f1536fc7-620b-4914-83c3-003601f6aa27"],

Cell["\<\
ContractTermLeft[Tleft_,Btensor_,ppp_,Aright_]:=Table[Sum[Tleft[[i,j]]*\
Btensor[[j,k,l]]*ppp[[k,l,m]]*Conjugate[Aright[[n,m]]],(*A\[Dagger] \
element:row n,col m*){j,3},{k,3},{l,3},{m,3}],{i,3},{n,3}];\
\>", "Input",
 CellLabel->
  "In[262]:=",ExpressionUUID->"aa522dd0-a6e1-40dc-89ae-ece397fc01c5"],

Cell["\<\
ContractTermRight[leftM_,ppp_,Bright_]:=Table[Sum[leftM[[i,j]]*ppp[[j,k,l]]*\
Conjugate[Bright[[n,k,l]]],(*B\[Dagger] \
element*){j,3},{k,3},{l,3}],{i,3},{n,3}];\
\>", "Input",
 CellLabel->
  "In[263]:=",ExpressionUUID->"6eb2b060-495c-49c0-933f-77dd85100f5d"],

Cell["\<\
(*TrIm of a 3x3 matrix*)
TrIm[M_]:=Im[Tr[M]];\
\>", "Input",
 CellLabel->
  "In[264]:=",ExpressionUUID->"262b083d-7e48-4ea9-a313-5b2b9a84637a"],

Cell["\<\
(* Triple correlator: see the revised block in the next cell *)\
\>", "Input",
 CellLabel->
  "In[266]:=",ExpressionUUID->"c36aa352-6df1-4725-b2ca-f950c6d05ad2"],

Cell["\<\
(* ===========================================================================\
= *)
(*  REVISION (nonlinear part, same as Code_nolinear_ver38.m):                 \
  *)
(*  [F1] A11, A21, B11, B21 use P21^{-1} = (I - T21 a1 T12 a2)^{-1}           \
  *)
(*       (notes Eqs. 20, 22, 26, 28); also affects integL12 through A11/A21.  \
   *)
(*  [F2] A and B (not their daggers) are passed to ContractTermLeft/Right,    \
  *)
(*       which conjugate internally (removes a double dagger).                \
   *)
(*  [F3] particle 1 fluctuations at T1, particle 2 at T2 (as in integL12).    \
   *)
(*  [F4] symmetrized triple correlator (SI-ver2_7 Eq. 65), closed form below; \
  *)
(*       prefactor 1/(6 Pi^2)/(2 Pi) -> 1/(2 Pi).                             \
  *)
(*  w1 is kept in (0,w) as before.                                            \
  *)
(* ===========================================================================\
= *)

(* ================================================================*)
(*  [F4] TRIPLE CORRELATOR  (SI-ver2_7 Eq. 65, symmetrized)          *)
(*                                                                  *)
(*  The absorbed power is the Hermitian operator (p.E + E.p)/2, so   *)
(*  the correlator entering <p E^dagger> is the symmetrized one,     *)
(*  (1/4)<{p^lam*(w),{p^mu(w1),p^nu(w2)}}>. Summing the four ordered *)
(*  correlators of Eq. (65) and using coth(a+b)=(1+CaCb)/(Ca+Cb)      *)
(*  gives the closed form                                            *)
(*                                                                  *)
(*   (1/4)<{p^lam*(w),{p^mu(w1),p^nu(w2)}}> = 2 Pi hbar^2 C x        *)
(*     [ C2 Re b^{mu nu lam}(w2,-w) + C1 Re b^{nu mu lam}(w1,-w)     *)
(*       - (C1+C2) Re b^{lam mu nu}(w1,w2) ] delta(w-w1-w2)          *)
(*                                                                  *)
(*  C = coth(hbar w/2kT), C1 = coth(hbar w1/2kT), C2 = coth(hbar w2/2kT).*)
(*  Same symmetrization as the coth linear FDT used in integL12.     *)
(*  Classical limit: 8 Pi (kT)^2 [X1/(w w2)+X2/(w w1)-X3/(w1 w2)],   *)
(*  i.e. SI-ver2_7 Eq. (66).                                         *)
(*                                                                  *)
(*  TripleKa returns the bracket times C (the factor 2 Pi is in      *)
(*  prefNL; hbar^2 is absorbed in the normalization as before).      *)
(*  Index order {mu (w1), nu (w2), lam (p^* at w)} -> ppp[[k,l,m]].  *)
(*  The B^dagger terms need the Hermitian conjugate, which for the    *)
(*  (real) symmetrized correlator is Transpose[ppp,{2,3,1}].          *)
(*  Mathematica Transpose[T,{n1,n2,n3}]: level k of T -> level nk.    *)
(* ================================================================*)

omOf[1]=om01; omOf[2]=om02;
cothT[j_,f_,T_]:=CothSafe[hbar*om001*omOf[j]*f/(2*kB*T)];

TripleKa[j_?IntegerQ,w_?NumericQ,w1_?NumericQ,T_?NumericQ]:=Module[{w2,C,C1,\
C2,X1,X2,X3,sB12,sB2N0,sB1N0},
  w2=w-w1;
  {sB12,sB2N0,sB1N0}=If[j==1,
     {s1B12[w,w1],s1B2N0[w,w1],s1B1N0[w,w1]},
     {s2B12[w,w1],s2B2N0[w,w1],s2B1N0[w,w1]}];
  C=cothT[j,w,T]; C1=cothT[j,w1,T]; C2=cothT[j,w2,T];
  X1=Re[sB2N0];                              (* Re b^{mu nu lam}(w2,-w)  *)
  X2=Transpose[Re[sB1N0],{2,1,3}];           (* Re b^{nu mu lam}(w1,-w)  *)
  X3=Transpose[Re[sB12],{3,1,2}];            (* Re b^{lam mu nu}(w1,w2)  *)
  C*(C2*X1+C1*X2-(C1+C2)*X3)];
\
\>", "Input",
 CellLabel->
  "In[267]:=",ExpressionUUID->"5d58456e-d0bd-448e-b9d3-f7d6a64ed05b"],

Cell["\<\
(* TripleCorr2 removed: TripleKa[j,...] in the previous cell covers particle \
1 (j=1) and particle 2 (j=2) *)\
\>", "Input",
 CellLabel->
  "In[310]:=",ExpressionUUID->"672c06c8-aa6b-4475-8cf3-efb99a596977"],

Cell["\<\
integNL12[r2_?NumericQ,w_?NumericQ,w1_?NumericQ,temp1_?NumericQ,temp2_?\
NumericQ]:=Module[{w2,Rn,RRmat,II3,(*T matrices at w,w1,w2*)
T12w,T21w,T12w1,T21w1,T12w2,T21w2,(*Alpha tensors at w,w1,w2*)
Al1w,Al2w,Al1w1,Al2w1,Al1w2,Al2w2,(*Pinv at w,w1,w2*)
PinvMw,PinvMw1,PinvMw2,(*A tensors at w1 and w2 (needed for M tensors)*)
A11w1,A12w1,A21w1,A22w1,A11w2,A12w2,A21w2,A22w2,(*A tensors at w (needed for \
B tensors and integrand)*)
A11w,A12w,A21w,A22w,PinvNw,PinvNw1,PinvNw2,(*T inverses at w*)
T21invw,T12invw,(*beta scalars*)
beta1,beta2,(*M tensors*)Mtens111,Mtens112,Mtens221,Mtens222,(*B tensors*)
B11tens,B12tens,B21tens,B22tens,(*Triple correlators*)
ppp1,ppp2,Dagppp1,Dagppp2,prefNL,(*Terms*)
term11,term12,term13,term14,term21,term22,term23,term24, GgeoNL1,GgeoNL2},

w2=w-w1;
{Rn,RRmat}=geoData[r2];
II3=IdentityMatrix[3];

(*\[HorizontalLine]\[HorizontalLine] T matrices \[HorizontalLine]\
\[HorizontalLine]*)T12w=Tn12[w,Rn,RRmat];
T21w=Tn21[w,Rn,RRmat];
T12w1=Tn12[w1,Rn,RRmat];
T21w1=Tn21[w1,Rn,RRmat];
T12w2=Tn12[w2,Rn,RRmat];
T21w2=Tn21[w2,Rn,RRmat];

(*\[HorizontalLine]\[HorizontalLine] Alpha tensors \[HorizontalLine]\
\[HorizontalLine]*)
Al1w=alphaTens1[w];
Al2w=alphaTens2[w];
Al1w1=alphaTens1[w1];
Al2w1=alphaTens2[w1];
Al1w2=alphaTens1[w2];
Al2w2=alphaTens2[w2];

(*\[HorizontalLine]\[HorizontalLine] Pinv at each frequency \[HorizontalLine]\
\[HorizontalLine]*)
PinvMw=Inverse[II3-T12w . Al2w . T21w . Al1w];        (* P12^{-1} *)
PinvMw1=Inverse[II3-T12w1 . Al2w1 . T21w1 . Al1w1];
PinvMw2=Inverse[II3-T12w2 . Al2w2 . T21w2 . Al1w2];
PinvNw=Inverse[II3-T21w . Al1w . T12w . Al2w];        (* P21^{-1}  [F1] *)
PinvNw1=Inverse[II3-T21w1 . Al1w1 . T12w1 . Al2w1];
PinvNw2=Inverse[II3-T21w2 . Al1w2 . T12w2 . Al2w2];

(*\[HorizontalLine]\[HorizontalLine] A tensors at w (for B tensors and \
ContractTerm) \[HorizontalLine]\[HorizontalLine]*)
A11w=T12w . Al2w . PinvNw . T21w;   (* [F1] *)
A12w=PinvMw . T12w;
A21w=PinvNw . T21w;                (* [F1] *)
A22w=T21w . Al1w . PinvMw . T12w;
(* [F2] daggers are taken inside ContractTermLeft/Right; not needed here *)

(*\[HorizontalLine]\[HorizontalLine] A tensors at w1 (for M tensors) \
\[HorizontalLine]\[HorizontalLine]*)
A11w1=T12w1 . Al2w1 . PinvNw1 . T21w1;   (* [F1] *)
A12w1=PinvMw1 . T12w1;
A21w1=PinvNw1 . T21w1;                  (* [F1] *)
A22w1=T21w1 . Al1w1 . PinvMw1 . T12w1;

(*\[HorizontalLine]\[HorizontalLine] A tensors at w2 (for M tensors) \
\[HorizontalLine]\[HorizontalLine]*)
A11w2=T12w2 . Al2w2 . PinvNw2 . T21w2;   (* [F1] *)
A12w2=PinvMw2 . T12w2;
A21w2=PinvNw2 . T21w2;                  (* [F1] *)
A22w2=T21w2 . Al1w2 . PinvMw2 . T12w2;

(*\[HorizontalLine]\[HorizontalLine] T inverses at w \[HorizontalLine]\
\[HorizontalLine]*)
T21invw=Inverse[T21w];
T12invw=Inverse[T12w];

(*\[HorizontalLine]\[HorizontalLine] Beta scalars \[HorizontalLine]\
\[HorizontalLine]*)
beta1=s1B12[w,w1];
beta2=s2B12[w,w1];

(*\[HorizontalLine]\[HorizontalLine] M tensors:beta contracted with A at w1 \
and w2 \[HorizontalLine]\[HorizontalLine]*)
Mtens111=TensorContract[TensorProduct[beta1,A11w1,A11w2],{{2,4},{3,6}}];
Mtens112=TensorContract[TensorProduct[beta1,A12w1,A12w2],{{2,4},{3,6}}];
Mtens221=TensorContract[TensorProduct[beta2,A21w1,A21w2],{{2,4},{3,6}}];
Mtens222=TensorContract[TensorProduct[beta2,A22w1,A22w2],{{2,4},{3,6}}];

(*\[HorizontalLine]\[HorizontalLine] B tensors (inline,no global \
B11/B12/B21/B22 calls) \[HorizontalLine]\[HorizontalLine]*)
B11tens=T12w . Al2w . PinvNw . (T21w . Al1w . T12w . Mtens221+T21w . \
Mtens111)+T12w . Mtens221;   (* [F1] notes Eq. 26 *)
B12tens=PinvMw . (T12w . Al2w . T21w . Mtens112+T12w . Mtens222);             \
                   (* notes Eq. 27 *)
B21tens=PinvNw . (T21w . Al1w . T12w . Mtens221+T21w . Mtens111);             \
                   (* [F1] notes Eq. 28 *)
B22tens=T21w . Al1w . PinvMw . (T12w . Al2w . T21w . Mtens112+T12w . \
Mtens222)+T21w . Mtens112;
(* [F2] no ConjugateTranspose here (ContractTermRight conjugates B itself) *)

(*\[HorizontalLine]\[HorizontalLine] Triple correlators \[HorizontalLine]\
\[HorizontalLine]*)
(* [F3][F4] particle 1 at T1, particle 2 at T2 *)
ppp1=TripleKa[1,w,w1,temp1];          (* index order {mu,nu,lam} *)
ppp2=TripleKa[2,w,w1,temp2];
Dagppp1=Transpose[ppp1,{2,3,1}];      (* index order {lam,mu,nu} *)
Dagppp2=Transpose[ppp2,{2,3,1}];

(*\[HorizontalLine]\[HorizontalLine] Terms for Q1->2 (particle 1 absorbing) \
\[HorizontalLine]\[HorizontalLine]*)
(* notes Eq. 43; [F2] pass A and B (not their daggers); [F3] correct \
temperatures *)
term11=TrIm@ContractTermLeft[T21invw,B21tens,ppp1,A11w];
term12=TrIm@ContractTermLeft[T21invw,B22tens,ppp2,A12w];
term13=TrIm@ContractTermRight[T21invw . A21w,Dagppp1,B11tens];
term14=TrIm@ContractTermRight[T21invw . A22w,Dagppp2,B12tens];

(*\[HorizontalLine]\[HorizontalLine] Terms for Q2->1 (particle 2 absorbing) \
\[HorizontalLine]\[HorizontalLine]*)
term21=TrIm@ContractTermLeft[T12invw,B12tens,ppp2,A22w];
term22=TrIm@ContractTermLeft[T12invw,B11tens,ppp1,A21w];
term23=TrIm@ContractTermRight[T12invw . A12w,Dagppp2,B22tens];
term24=TrIm@ContractTermRight[T12invw . A11w,Dagppp1,B21tens];

(*\[HorizontalLine]\[HorizontalLine] Net heat transfer Q12-Q21 \
\[HorizontalLine]\[HorizontalLine]*)
(* [F4] 2 Pi (correlator)  x  1/(2 Pi) (d w/2 Pi)  x  1/(2 Pi) (sum over w1 = \
Integral d w1/2 Pi) *)
prefNL=(2*Pi)*1/(2*Pi)*1/(2*Pi);
GgeoNL2=prefNL*om02^3*(term21+term22+term23+term24);
GgeoNL1=prefNL*om01^3*(term11+term12+term13+term14);
w*(GgeoNL1-GgeoNL2)];\
\>", "Input",
 CellLabel->
  "In[311]:=",ExpressionUUID->"ae4880c5-8b72-4e13-92ae-8da9dad26f75"],

Cell["\<\
(* ================================================================*)
(*SECTION 11:The integral for the linear terms and the Compactified double \
integral for the nonlinear terms*)
(* ================================================================*)
(**)
(*Change of variables:*)
(*u=w/(1+w) in[0,1],w=u/(1-u)*)
(*v=w1/w in[0,1],w1=v*w*)
(**)
(*Jacobian:dw/du=1/(1-u)^2*)
(*dw1/dv=w (for fixed u)*)
(*            =>d(w,w1)/d(u,v)=w/(1-u)^2*)
(**)
(*Net power of w in integrand:*)
(*prefactor contributes 1/w*)
(*Jacobian contributes w*)
(*    =>integrand~w^0 at u=0 (finite,no singularity)*)
(**)
(*Boundary v=1 (w1=w,w2=0):handled by CothReg.*)
(*No Exclusions needed.*)
(* ================================================================*)\
\>", "Input",
 CellLabel->
  "In[312]:=",ExpressionUUID->"5ef3f16c-5112-4ddd-ade0-dc7593e0517a"],

Cell["\<\
QL12[r2_?NumericQ]:=NIntegrate[integL12[r2,w,T1,T2],{w,0,Infinity},Method->{\"\
GlobalAdaptive\",\"SingularityHandler\"->\"IMT\"},AccuracyGoal->Infinity,\
PrecisionGoal->8,MaxRecursion->100];\
\>", "Input",
 CellChangeTimes->{{3.995106758016364*^9, 3.9951067885073013`*^9}, {
   3.9951084889209967`*^9, 3.9951085120658045`*^9}, 3.995108643720255*^9, {
   3.995108730727704*^9, 3.99510877452192*^9}},
 CellLabel->
  "In[332]:=",ExpressionUUID->"93af076e-48d6-4e2e-9099-325f898349f1"],

Cell["\<\
QNL12[r2_?NumericQ]:=NIntegrate[
(u/(1-u)^3)*integNL12[r2,u/(1-u),u*v/(1-u),T1,T2],{u,0,1},{v,0,1},Method->{\"\
GlobalAdaptive\",\"SingularityHandler\"->\"IMT\",\"MaxErrorIncreases\"->100},\
AccuracyGoal->8, PrecisionGoal->4, MaxRecursion->100];\
\>", "Input",
 CellChangeTimes->{
  3.9951068283413563`*^9, {3.9951068989910603`*^9, 3.9951069354684815`*^9}, {
   3.995115297970297*^9, 3.995115340651482*^9}, {3.9951154488310947`*^9, 
   3.995115476639586*^9}, {3.9951163989941416`*^9, 3.9951164120044627`*^9}, {
   3.9953596525681214`*^9, 3.995359661350412*^9}},
 CellLabel->
  "In[333]:=",ExpressionUUID->"b90add91-536f-4b82-96b5-734c2ef2f077"],

Cell["\<\
r2ListUnit=Join[Table[10^i,{i,Log10[1],1-1/50,1/50}],Table[10^i,{i,1,3,1/50}]];
r2List=r2ListUnit/EffR2;\
\>", "Input",
 CellChangeTimes->{{3.995107632127054*^9, 3.995107633192233*^9}, {
  3.995107677386532*^9, 3.9951076796632695`*^9}, {3.9951077128469677`*^9, 
  3.9951077130243964`*^9}, {3.995107937471978*^9, 3.9951079377495317`*^9}, {
  3.995108393111062*^9, 3.995108395139966*^9}, {3.9951084819136076`*^9, 
  3.9951084821690254`*^9}},
 CellLabel->
  "In[334]:=",ExpressionUUID->"8b5dba99-668a-42d9-9e1d-d9b833472228"],

Cell["\<\
QL12List=Table[Module[{val},
val=hbar*om001^2*QL12[r2];
{r2,val}],
{r2,r2List}];\
\>", "Input",
 CellLabel->
  "In[336]:=",ExpressionUUID->"3f5374f0-2586-4aea-a711-a8a691271005"],

Cell["\<\
QNL12List=Table[Module[{val},
val=hbar*om001^2*QNL12[r2];
{r2,val}],
{r2,r2List}];\
\>", "Input",
 CellLabel->
  "In[337]:=",ExpressionUUID->"556205d0-4775-4265-ad04-54f4da9f20ae"],

Cell["\<\
QTotalList=Table[Module[{val},
val=hbar*om001^2*(QL12[r2]+QNL12[r2]);
{r2,val}],
{r2,r2List}];\
\>", "Input",
 CellLabel->
  "In[338]:=",ExpressionUUID->"a9995dfe-f643-410c-98cb-eef253564445"],

Cell["\<\
QL12ListUnit={#[[1]]*EffR2,#[[2]]}&/@QL12List;
QNL12ListUnit={#[[1]]*EffR2,#[[2]]}&/@QNL12List;
QTotalListUnit={#[[1]]*EffR2,#[[2]]}&/@QTotalList;\
\>", "Input",
 CellLabel->
  "In[339]:=",ExpressionUUID->"39739dad-ed32-4f22-be95-4c8607204765"],

Cell["\<\
(* ===========================================================================\
= *)
(*   Q vs r2   -   Two identical dipoles   (log-log)                          \
  *)
(*                                                                     *)
(*   This version:                                                            \
  *)
(*     - removes the stray horizontal line at 10^0  (it was the default Axes  \
  *)
(*       line at y = 0; killed with  Axes -> False)                           \
  *)
(*     - prints the tick labels  10^0 -> 1  and  10^1 -> 10                   \
  *)
(*     - exposes ALL style knobs in the STYLE CONTROL PANEL below             \
  *)
(*                                                                     *)
(*   Requires:  QNL12ListUnit, QL12ListUnit, QTotalListUnit                   \
  *)
(*              (each a list of {r2 [Angstrom], Q [eV/s]}),  EffR2            \
  *)
(* ===========================================================================\
= *)
(* ---------------------------------------------------------------------------\
- *)
(*  Q vs R  ->  values needed ONLY by the CSV export below                    \
   *)
(*  (all plotting/style removed; window + axis extents kept for the metadata) \
   *)
(* ---------------------------------------------------------------------------\
- *)
r2LoA = EffR2;      (* left edge of the r2 window, Angstrom  *)
r2HiA = 1000.0;     (* right edge of the r2 window, Angstrom *)\
\>", "Input",
 CellLabel->
  "In[342]:=",ExpressionUUID->"4a070eb8-4135-4539-8d10-30c283ba1007"],

Cell[CellGroupData[{

Cell["\<\
xLo = Log10[r2LoA];  xHi = Log10[r2HiA];
With[{allY = Log10[Abs[#[[2]]]] & /@
       Select[Join[QNL12ListUnit, QL12ListUnit, QTotalListUnit],
              r2LoA <= #[[1]] <= r2HiA && #[[2]] != 0 &]},
   yLo = Floor[Min[allY]];  yHi = Ceiling[Max[allY]]]\
\>", "Input",
 CellLabel->
  "In[360]:=",ExpressionUUID->"51d6af2e-f127-49bc-a6ff-9199fefad99e"],

Cell[BoxData["9"], "Output",
 CellChangeTimes->{3.99445124211434*^9, 3.9944518699065046`*^9, 
