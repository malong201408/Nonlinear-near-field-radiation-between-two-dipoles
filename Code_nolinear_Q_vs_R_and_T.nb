Cell["\<\
(* ===========================================================================\
= *)
(* ===========================================================================\
= *)
(*                                                                            \
  *)
(*   Q vs R  --  TEMPERATURE SWEEP                                            \
  *)
(*                                                                            \
  *)
(*   T1 = 50 K is held FIXED (cold body).                                     \
  *)
(*   T2 (hot body) is swept over {100, 200, 300, 400, 500} K.                 \
  *)
(*                                                                            \
  *)
(*   For every T2 regime the code recomputes the SAME three curves as the     \
   *)
(*   Q-vs-R figure above -- QL12 (linear), QNL12 (nonlinear) and their sum    \
  *)
(*   QTotal -- over the SAME r2List / window, then exports them for OriginLab \
   *)
(*   in the SAME sign-split |Q| log-log style as Q_vs_R_series.csv.           \
  *)
(*                                                                            \
  *)
(*   Exports (into ./figures):                                                \
  *)
(*     Q_vs_R_Tsweep_series.csv  wide, sign-split (pos/neg) |Q|, one block/T2 \
  *)
(*     Q_vs_R_Tsweep_long.csv    tidy long : T2_K, R_Angstrom, QL, QNL, QTot  \
  *)
(*     Q_vs_R_Tsweep_axes.csv    log-log window + sweep metadata              \
  *)
(*     Q_vs_R_Tsweep_preview.png quick Mathematica overlay (makePreviewPlot)  \
  *)
(* ===========================================================================\
= *)\
\>", "Input",
 CellLabel->
  "In[367]:=",ExpressionUUID->"b97d7be3-e86c-4d61-a206-ae2958f13135"],

Cell["\<\
(* ---- sweep control panel (edit here) \
--------------------------------------- *)
T1sweep = 50;                          (* K, fixed cold body                  \
  *)
T2sweep = {50, 100, 200, 300, 400, 500};   (* K, hot-body sweep               \
      *)
makePreviewPlot = True;                (* also write a quick .png overlay     \
   *)\
\>", "Input",
 CellChangeTimes->{{3.998648816501794*^9, 3.9986488180644245`*^9}, {
  3.998652549164672*^9, 3.998652549307418*^9}, {3.9986609024694843`*^9, 
  3.998660902769951*^9}},
 CellLabel->
  "In[386]:=",ExpressionUUID->"81468dc9-a53e-4257-b154-f284728cf282"],

Cell["\<\
(* ---- memoize the r2-only geometry (bounded, big speed-up over the sweep) \
---- *)
geoData[r2_?NumericQ] := geoData[r2] = Module[{Rvec, Rn, Rhat},
   Rvec = r1n - r2n[r2]; Rn = Norm[Rvec]; Rhat = Rvec/Rn;
   {Rn, Outer[Times, Rhat, Rhat]}];\
\>", "Input",
 CellLabel->
  "In[390]:=",ExpressionUUID->"99377d2f-11aa-4531-a646-8982a28c4ccb"],

Cell["\<\
(* ---- temperature-parameterized integrals (reuse integL12 / integNL12) \
------ *)
(*      identical NIntegrate settings to QL12 / QNL12 above, but with t1,t2   \
   *)
QL12T[r2_?NumericQ, t1_?NumericQ, t2_?NumericQ] :=
  NIntegrate[integL12[r2, w, t1, t2], {w, 0, Infinity},
     Method -> {\"GlobalAdaptive\", \"SingularityHandler\" -> \"IMT\"},
     AccuracyGoal -> Infinity, PrecisionGoal -> 8, MaxRecursion -> 100];\
\>", "Input",
 CellChangeTimes->{{3.9951068655375347`*^9, 3.9951068717143354`*^9}},
 CellLabel->
  "In[392]:=",ExpressionUUID->"7a14e487-33f0-4468-b617-c0aae1a292bc"],

Cell["\<\
QNL12T[r2_?NumericQ, t1_?NumericQ, t2_?NumericQ] :=
  NIntegrate[(u/(1 - u)^3)*integNL12[r2, u/(1 - u), u*v/(1 - u), t1, t2],
     {u, 0, 1}, {v, 0, 1},
     Method -> {\"GlobalAdaptive\", \"SingularityHandler\" -> \"IMT\",
                \"MaxErrorIncreases\" -> 100},
     AccuracyGoal -> 8, PrecisionGoal -> 4, MaxRecursion -> 60];\
\>", "Input",
 CellChangeTimes->{{3.995106878754072*^9, 3.99510688544176*^9}, {
  3.9951164415463104`*^9, 3.9951164489644995`*^9}, {3.9953596808977194`*^9, 
  3.995359681818194*^9}},
 CellLabel->
  "In[395]:=",ExpressionUUID->"c9d21bae-7ede-45e2-8d92-cbbd8380e59e"],

Cell[CellGroupData[{

Cell["\<\
(* ---- compute all three curves for each T2 (reuses r2List, EffR2) \
----------- *)
(*      stored physical units:  R [Angstrom]  and  Q [eV/s]                   \
   *)
Print[\"Q-vs-R temperature sweep:  T1 = \", T1sweep, \" K ;  T2 = \", \
T2sweep, \" K\"];
Print[\"  \", Length[r2List], \" R-points per curve, \", Length[T2sweep], \" \
regimes.\"];\
\>", "Input",
 CellLabel->
  "In[396]:=",ExpressionUUID->"5a8a41c2-6b90-4653-b641-0669cc7c540d"],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Q-vs-R temperature sweep:  T1 = \"\>", "\[InvisibleSpace]", 
   "50", "\[InvisibleSpace]", "\<\" K ;  T2 = \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{
    "50", ",", "100", ",", "200", ",", "300", ",", "400", ",", "500"}], "}"}],
    "\[InvisibleSpace]", "\<\" K\"\>"}],
  SequenceForm[
  "Q-vs-R temperature sweep:  T1 = ", 50, " K ;  T2 = ", {50, 100, 200, 300, 
   400, 500}, " K"],
  Editable->False]], "Print",
