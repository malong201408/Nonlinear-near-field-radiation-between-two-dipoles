Cell["(*beta tensor*)", "Input",
 CellLabel->"In[87]:=",ExpressionUUID->"a73bbe41-40d0-4afe-957b-458050203bba"],

Cell["\<\
(*beta tensor construction and symmetry rules*)
(*Indices:1=x,2=y,3=z*)
beta=Array[b,{3,3,3}];\
\>", "Input",
 CellLabel->"In[88]:=",ExpressionUUID->"5e1266f3-aa64-420a-a1af-2d9b9c2e8635"],

Cell["\<\
(*beta values MUST put into accending order i.e.[yxx]->[xxy]*)
betaValues1={
b[1,1,1]->-250,(*\[Beta]_xxx*)
b[1,1,2]->0,(*\[Beta]_xxy*)
b[2,2,2]->0,(*\[Beta]_yyy*)
b[1,2,2]->0(*\[Beta]_xyy*)};
\
\>", "Input",
 CellChangeTimes->{{3.994844526014986*^9, 3.994844535743205*^9}, {
  3.995035439184408*^9, 3.9950355042096577`*^9}, {3.995359386600786*^9, 
  3.995359515109617*^9}, {3.9953624634709315`*^9, 3.9953624702359405`*^9}},
 CellLabel->"In[91]:=",ExpressionUUID->"6a6706a1-26a1-4578-88a1-611c438bfd0a"],

Cell["\<\
betaValues2={
b[1,1,1]->-250,(*\[Beta]_xxx*)
b[1,1,2]->0,(*\[Beta]_xxy*)
b[2,2,2]->0,(*\[Beta]_yyy*)
b[1,2,2]->0(*\[Beta]_xyy*)};
\
\>", "Input",
 CellChangeTimes->{{3.9948445394242387`*^9, 3.994844549471168*^9}, {
   3.9950355090315647`*^9, 3.9950355368652816`*^9}, {3.995102640117174*^9, 
   3.995102641083543*^9}, 3.9951026767588325`*^9, {3.9953595230830455`*^9, 
   3.9953595253321843`*^9}, {3.9953624739386015`*^9, 3.995362480334764*^9}},
 CellLabel->"In[94]:=",ExpressionUUID->"f57386e8-f5f6-43a8-8cd6-d4b8f54fff5f"],

Cell["\<\
betaTensor1=Array[
Function[{i,j,k},
b@@Sort[{i,j,k}]/.betaValues1/. b[__]->0],
{3,3,3}];\
\>", "Input",
 CellLabel->"In[96]:=",ExpressionUUID->"d1f94057-c32b-4e8d-8df7-89ba462fbd37"],

Cell["\<\
betaTensor2=Array[
Function[{i,j,k},
b@@Sort[{i,j,k}]/. betaValues2/. b[__]->0],
{3,3,3}];\
\>", "Input",
 CellLabel->"In[97]:=",ExpressionUUID->"ad3b085b-b2a7-45b0-9962-e8ebc18c7990"],

Cell[CellGroupData[{

Cell["\<\
betaTensor1
betaTensor2\
\>", "Input",
 CellLabel->"In[98]:=",ExpressionUUID->"3a1bfe81-1c66-43d7-906d-66f556c0b9dc"],

