Cell[CellGroupData[{

Cell["\<\
(* ===========================================================================\
= *)
(*   Q vs T2  --  TEMPERATURE SWEEP AT FIXED SEPARATION                       \
  *)
(*                                                                            \
  *)
(*   T1 is held FIXED (cold body) and T2 (hot body) is swept over a DENSE \
grid  *)
(*   of points, evaluated at the fixed separations R = {10, 15} Angstrom.     \
  *)
(*   For each R it computes QL12 (linear), QNL12 (nonlinear) and their sum    \
  *)
(*   QTotal as functions of T2, then exports them for OriginLab plotting      \
  *)
(*   (Q on y, T2 on x) and writes an optional preview PNG.                    \
  *)
(*                                                                            \
  *)
(*   Reuses QL12T / QNL12T (temperature-parameterized integrals) and geoData  \
  *)
(*   defined in the Q-vs-R temperature-sweep section above.                   \
  *)
(*                                                                            \
  *)
(*   Exports (into ./figures):                                                \
  *)
(*     Q_vs_T2_series.csv   wide : T2_K  then QL/QNL/QTot for each R          \
  *)
(*     Q_vs_T2_long.csv     tidy : R_Angstrom, T2_K, QL, QNL, QTot            \
 *)
(*     Q_vs_T2_axes.csv     sweep metadata                                    \
  *)
(*     Q_vs_T2_preview.png  quick Q_total-vs-T2 overlay (makeT2Preview)       \
  *)
(* ===========================================================================\
= *)

(* ---- control panel (edit here) \
--------------------------------------------- *)
T1fix   = 50;              (* K, fixed cold body                              \
 *)
T2min   = 50;             (* K, sweep start (T2 = T1 gives the zero crossing) \
 *)
T2max   = 600;             (* K, sweep end                                    \
 *)
nT2     = 56;              (* number of T2 points  (dense sampling)           \
 *)
RfixAng = {15., 50.};      (* Angstrom, fixed separations to evaluate at      \
  *)
makeT2Preview = True;      (* also write a quick .png overlay                 \
  *)

T2grid = N@Subdivide[T2min, T2max, nT2 - 1];   (* shared T2 axis (all R)      \
 *)

(* fixed R [Angstrom] -> normalized r2   (r2ToAng[r2] = r2*EffR2) *)
r2ofR[RAng_] := N[RAng/EffR2];
rtag[RA_]    := ToString[If[RA == Round[RA], Round[RA], RA]];  (* clean label \
  *)

Print[\"Q-vs-T2 sweep:  T1 = \", T1fix, \" K ;  T2 in [\", T2min, \", \", \
T2max,
      \"] K (\", nT2, \" pts) ;  R = \", RfixAng, \" Angstrom\"];

(* ---- compute QL, QNL, QTot vs T2 at each fixed R (physical units eV/s) \
------ *)
qT2 = Association[];
Do[
  Module[{r2n0, qlL, qnlL, qtotL, tT},
   r2n0 = r2ofR[RA];
   tT = AbsoluteTiming[
     qlL  = Table[{t2, hbar*om001^2*QL12T[r2n0, T1fix, t2]},  {t2, T2grid}];
     qnlL = Table[{t2, hbar*om001^2*QNL12T[r2n0, T1fix, t2]}, {t2, T2grid}];
     qtotL = MapThread[{#1[[1]], #1[[2]] + #2[[2]]} &, {qlL, qnlL}];
   ][[1]];
   qT2[RA] = <|\"QL\" -> qlL, \"QNL\" -> qnlL, \"QTot\" -> qtotL|>;
   Print[\"  R = \", RA, \" Angstrom  done   (\", NumberForm[tT, 4], \" s)\"];
  ],
  {RA, RfixAng}];

(* ===========================================================================\
= *)
(*  DATA EXPORT FOR ORIGINLAB  --  Q vs T2 at fixed R                         \
  *)
(* ===========================================================================\
= *)
Module[{clean, hdr, wide, long, meta},
  clean[x_] := Chop[Re[N[x]], 10^-30];

  (* WIDE : single shared X column (T2_K) + QL/QNL/QTot per R -> easy in \
Origin *)
  hdr = Prepend[
    Flatten[Table[{\"QL_R\" <> rtag[RA] <> \"A\", \"QNL_R\" <> rtag[RA] <> \
\"A\",
                   \"QTot_R\" <> rtag[RA] <> \"A\"}, {RA, RfixAng}]], \
\"T2_K\"];
  wide = Table[
     Prepend[
       Flatten[Table[
         {clean[qT2[RA][\"QL\"][[k, 2]]], clean[qT2[RA][\"QNL\"][[k, 2]]],
          clean[qT2[RA][\"QTot\"][[k, 2]]]}, {RA, RfixAng}]],
       N[T2grid[[k]]]],
     {k, Length[T2grid]}];
  Export[FileNameJoin[{outDir, \"Q_vs_T2_series.csv\"}], Prepend[wide, hdr], \
\"CSV\"];

  (* LONG / tidy : one row per (R, T2), signed Q *)
  long = Flatten[
    Table[
      MapThread[
        {RA, #1[[1]], clean[#1[[2]]], clean[#2[[2]]], clean[#3[[2]]]} &,
        {qT2[RA][\"QL\"], qT2[RA][\"QNL\"], qT2[RA][\"QTot\"]}],
      {RA, RfixAng}], 1];
  Export[FileNameJoin[{outDir, \"Q_vs_T2_long.csv\"}],
     Prepend[long, {\"R_Angstrom\", \"T2_K\", \"QL_eVs\", \"QNL_eVs\", \
\"QTot_eVs\"}], \"CSV\"];

  meta = {{\"T1_K\", N[T1fix]}, {\"T2_min_K\", N[T2min]}, {\"T2_max_K\", \
N[T2max]},
          {\"nT2\", nT2}, {\"R_list_Ang\", ToString[RfixAng]}, \
{\"EffR2_Ang\", N[EffR2]}};
  Export[FileNameJoin[{outDir, \"Q_vs_T2_axes.csv\"}],
     Prepend[meta, {\"quantity\", \"value\"}], \"CSV\"];

  Print[\"Q vs T2 export -> \", outDir];
  Print[\"  Q_vs_T2_series.csv  (wide: T2_K + QL/QNL/QTot per R)\"];
  Print[\"  Q_vs_T2_long.csv    (tidy: R, T2, QL, QNL, QTot)\"];
];

(* ---- optional preview : Q_total vs T2 (linear axes, one line per R) \
--------- *)
If[TrueQ[makeT2Preview],
  Quiet@Check[
   Module[{curves, plt},
     curves = ({#[[1]], Re[N[#[[2]]]]} & /@ qT2[#][\"QTot\"]) & /@ RfixAng;
     plt = ListLinePlot[curves,
        PlotMarkers -> Automatic, Frame -> True, Axes -> False,
        GridLines -> Automatic,
        FrameLabel -> {\"T2  (K)\", \"Q_total  (eV/s)\"},
        PlotLegends -> Placed[
           ((\"R = \" <> rtag[#] <> \" A\") & /@ RfixAng), Right],
        PlotLabel -> \"Q vs T2   (T1 = \" <> ToString[T1fix] <> \" K)\",
        ImageSize -> 560];
     Export[FileNameJoin[{outDir, \"Q_vs_T2_preview.png\"}], plt];
     Print[\"  preview figure -> Q_vs_T2_preview.png\"];
   ],
   Print[\"  [note] preview PNG skipped (headless rasterization unavailable); \
\",
         \"use the CSV files in OriginLab.\"]]];\
\>", "Input",
 CellChangeTimes->{{3.9995964343567195`*^9, 3.999596446082733*^9}, {
  4.0003034333455706`*^9, 4.0003034369244947`*^9}},
 CellLabel->
  "In[413]:=",ExpressionUUID->"d5a90a5a-a1b2-44d3-8634-d79e8962449b"],

