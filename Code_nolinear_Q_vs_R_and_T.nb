(* Beginning of Notebook Content *)
Notebook[{

Cell[CellGroupData[{
Cell["Code_nolinear_ver34_Tsweep  (Q vs R + temperature sweep)", "Title",ExpressionUUID->"6dcca194-7552-4880-8423-c0f4039bf07d"],

Cell["(* ::Package:: *)", "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"fc753f48-cd5d-4286-953a-3d149684b599"],

Cell["\<\
(* ===========================================================================\
= *)
(*  Code_nolinear_ver5_export_only.m   (revised from ..._ver32_..._rev_ver5)  \
  *)
(*                                                                            \
  *)
(*  RUN:   wolframscript -file Code_nolinear_ver5_export_only.m               \
  *)
(*    or:  Get[\"Code_nolinear_ver5_export_only.m\"]  from a notebook / \
kernel    *)
(*                                                                            \
  *)
(*  DATA-EXPORT-ONLY build (ver34):  the integL12 / integNL12 HEAT-MAP code \
has  *)
(*  been REMOVED.  A new Q-vs-R TEMPERATURE-SWEEP section is added:           \
   *)
(*  T1 = 50 K is held fixed while T2 = {100,200,300,400,500} K is swept.      \
  *)
(*                                                                            \
  *)
(*  Writes CSV (and one optional preview PNG) into a ./figures subdirectory:  \
   *)
(*    Q_vs_R_series.csv , Q_vs_R_axes.csv            (original T1=300,T2=400) \
   *)
(*    Q_vs_R_Tsweep_series.csv                        wide, sign-split |Q|,   \
   *)
(*                                                     one block per T2 \
regime   *)
(*    Q_vs_R_Tsweep_long.csv                          tidy: T2, R, QL, QNL, \
QTot *)
(*    Q_vs_R_Tsweep_axes.csv                          log-log window / \
metadata  *)
(*    Q_vs_R_Tsweep_preview.png                       quick Mathematica \
overlay  *)
(*                                                     (makePreviewPlot flag) \
   *)
(*                                                                            \
  *)
(*  The *_Tsweep_series.csv file mirrors the ORIGINAL Q_vs_R_series.csv style \
   *)
(*  (each series sign-split into pos/neg columns of |Q| for log-log \
plotting),   *)
(*  so the temperature regimes overlay directly in OriginLab.                 \
   *)
(* ===========================================================================\
= *)\
\>", "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"dcb06f72-393e-483c-a4ff-f885ff29779d"],

Cell["\<\
(* ================================================================*)
(*Code_nonlinear_ver8.m*)
(*Nonlinear Casimir-Polder heat-transfer rate Q12=Q(T2)-Q(T1)*)
(**)(*Key fixes vs ver7:*)
(*The code is strictly following note_5_18*)
(*-Matrices order and off-diagonal terms is considered in AA and BB matrices*)
(*-Jacobian in the compactified integral corrected.*)(**)\
\>", "Input",
 CellLabel->"In[25]:=",ExpressionUUID->"2f244c92-f70e-4af0-b468-f5c3c0801b58"],

Cell["\<\
(* ================================================================*)\
\>", "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"8348e258-fbc4-4c3d-b247-8d9e0eebb74c"],

Cell["\<\
ClearSystemCache[]
ClearAll[\"Global`*\"];\
\>", "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"d028ea4a-f1ed-4f5b-92e6-c4c775fe0cdb"],

Cell["(*----EXPORT SETUP:evaluate once----*)", "Input",
 CellLabel->"In[35]:=",ExpressionUUID->"dc8fbe20-b8a6-48e6-911b-c92923651c1d"],

Cell["\<\
(* --- robust source file, base directory and code name: works in notebook \
AND wolframscript --- *)
srcFile = Quiet@Check[
   If[$InputFileName =!= \"\", $InputFileName, NotebookFileName[]],
   \"\"];
If[!StringQ[srcFile], srcFile = \"\"];

baseDir = Quiet@Check[
   If[srcFile =!= \"\", DirectoryName[srcFile], Directory[]],
   Directory[]];
If[!StringQ[baseDir] || baseDir === \"\", baseDir = Directory[]];

(* export folder is named after this notebook, e.g.
   Code_nolinear_ver38_RPPP_eta_Q_vs_R_and_Tsweep_M1_figures *)
codeName = Quiet@Check[
   If[srcFile =!= \"\", FileBaseName[srcFile], \"untitled\"],
   \"untitled\"];
If[!StringQ[codeName] || codeName === \"\", codeName = \"untitled\"];
codeName = StringReplace[codeName, Except[WordCharacter | \"_\" | \"-\" | \".\
\"] -> \"_\"];

outDir = FileNameJoin[{baseDir, codeName <> \"_figures\"}];
If[!DirectoryQ[outDir], CreateDirectory[outDir]];\
\>", "Input",
 CellLabel->"In[36]:=",ExpressionUUID->"3c1aa2f1-eecc-4d79-bc07-107d370f65c0"],

Cell["\<\
(* NOTE: all figure/plot generation removed - this version ONLY exports CSV \
data. *)\
\>", "Input",
 CellLabel->"In[50]:=",ExpressionUUID->"54519d84-c42c-4f21-8696-a614cb9745ac"],

