 InterpretationBox[
  RowBox[{"\<\"Q-vs-T2 sweep:  T1 = \"\>", "\[InvisibleSpace]", "50", 
   "\[InvisibleSpace]", "\<\" K ;  T2 in [\"\>", "\[InvisibleSpace]", "50", 
   "\[InvisibleSpace]", "\<\", \"\>", "\[InvisibleSpace]", "600", 
   "\[InvisibleSpace]", "\<\"] K (\"\>", "\[InvisibleSpace]", "56", 
   "\[InvisibleSpace]", "\<\" pts) ;  R = \"\>", "\[InvisibleSpace]", 
   RowBox[{"{", 
    RowBox[{"15.`", ",", "50.`"}], "}"}], 
   "\[InvisibleSpace]", "\<\" Angstrom\"\>"}],
  SequenceForm[
  "Q-vs-T2 sweep:  T1 = ", 50, " K ;  T2 in [", 50, ", ", 600, "] K (", 56, 
   " pts) ;  R = ", {15., 50.}, " Angstrom"],
  Editable->False]], "Print",
 CellChangeTimes->{3.994502193050855*^9, 3.994844892072092*^9, 
