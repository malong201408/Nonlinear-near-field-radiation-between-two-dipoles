Cell[CellGroupData[{

Cell["\<\
(* ===========================================================================\
= *)
(*  DATA EXPORT FOR ORIGINLAB  --  Q vs R temperature sweep                   \
  *)
(*  Mirrors the original Q_vs_R export: same window, same sign-split |Q|.     \
  *)
(* ===========================================================================\
= *)
Module[{clean, mkCol, series, maxLen, pad, tbl, hdr, long, meta,
        allSweep, allY, yLoS, yHiS},

  clean[x_] := Chop[Re[N[x]], 10^-30];

  (* same window + sign split + |Q| as the original figure/export *)
  mkCol[data_, sgn_] := Module[{d},
     d = Select[data, r2LoA <= #[[1]] <= r2HiA &];
     d = Select[d, sgn*clean[Last[#]] > 0 &];
     {clean[#[[1]]], Abs[clean[#[[2]]]]} & /@ d];

  (* one sign-split pos/neg pair per (T2 regime, quantity) *)
  series = Flatten[
    Table[
      With[{tag = ToString[t2v]},
       {{\"QL_T\"   <> tag <> \"_pos\", mkCol[sweepQ[t2v][\"QL\"],   1]},
        {\"QL_T\"   <> tag <> \"_neg\", mkCol[sweepQ[t2v][\"QL\"],  -1]},
        {\"QNL_T\"  <> tag <> \"_pos\", mkCol[sweepQ[t2v][\"QNL\"],  1]},
        {\"QNL_T\"  <> tag <> \"_neg\", mkCol[sweepQ[t2v][\"QNL\"], -1]},
        {\"QTot_T\" <> tag <> \"_pos\", mkCol[sweepQ[t2v][\"QTot\"], 1]},
        {\"QTot_T\" <> tag <> \"_neg\", mkCol[sweepQ[t2v][\"QTot\"],-1]}}],
      {t2v, T2sweep}],
    1];

  (* each series has its own R values -> pad to a common length *)
  maxLen = Max[Length /@ series[[All, 2]]];
  pad[d_] := Join[d, ConstantArray[{\"\", \"\"}, maxLen - Length[d]]];

  tbl = Transpose[Flatten[pad[#[[2]]], {{1}, {2}}] & /@ series, {2, 1, 3}];
  tbl = Flatten[#, 1] & /@ tbl;
  hdr = Flatten[{\"R_\" <> #[[1]], \"absQ_\" <> #[[1]]} & /@ series];
  tbl = Map[If[NumberQ[#] || Head[#] === Rational || Head[#] === Integer,
               N[#], #] &, tbl, {2}];
  Export[FileNameJoin[{outDir, \"Q_vs_R_Tsweep_series.csv\"}], Prepend[tbl, \
hdr], \"CSV\"];

  (* tidy / long format : one row per (T2, R), signed Q (no split) *)
  long = Flatten[
    Table[
      MapThread[
        {t2v, #1[[1]], clean[#1[[2]]], clean[#2[[2]]], clean[#3[[2]]]} &,
        {sweepQ[t2v][\"QL\"], sweepQ[t2v][\"QNL\"], sweepQ[t2v][\"QTot\"]}],
      {t2v, T2sweep}],
    1];
  Export[FileNameJoin[{outDir, \"Q_vs_R_Tsweep_long.csv\"}],
     Prepend[long, {\"T2_K\", \"R_Angstrom\", \"QL_eVs\", \"QNL_eVs\", \
\"QTot_eVs\"}], \"CSV\"];

  (* axis limits so Origin can match the original figure window *)
  allSweep = Flatten[Table[Join[sweepQ[t2v][\"QL\"], sweepQ[t2v][\"QNL\"],
                               sweepQ[t2v][\"QTot\"]], {t2v, T2sweep}], 1];
  allY = Log10[Abs[clean[#[[2]]]]] & /@
         Select[allSweep, r2LoA <= #[[1]] <= r2HiA && clean[#[[2]]] != 0 &];
  yLoS = Floor[Min[allY]];  yHiS = Ceiling[Max[allY]];
  meta = {{\"T1_K\", N[T1sweep]}, {\"T2_list_K\", ToString[T2sweep]},
          {\"xLo_log10\", N[xLo]}, {\"xHi_log10\", N[xHi]},
          {\"yLo_log10\", N[yLoS]}, {\"yHi_log10\", N[yHiS]},
          {\"R_min_Ang\", N[10.^xLo]}, {\"R_max_Ang\", N[10.^xHi]},
          {\"absQ_min\",  N[10.^yLoS]}, {\"absQ_max\",  N[10.^yHiS]},
          {\"EffR2_Ang\", N[EffR2]}};
  Export[FileNameJoin[{outDir, \"Q_vs_R_Tsweep_axes.csv\"}],
     Prepend[meta, {\"quantity\", \"value\"}], \"CSV\"];

  Print[\"Q vs R (T-sweep) export -> \", outDir];
  Print[\"  Q_vs_R_Tsweep_series.csv  (wide, sign-split |Q|)\"];
  Print[\"  Q_vs_R_Tsweep_long.csv    (tidy: T2_K, R, QL, QNL, QTot)\"];
  Print[\"  series rows: \", maxLen, \"   y-window log10: [\", yLoS, \", \", \
yHiS, \"]\"];
];\
\>", "Input",
 CellLabel->
  "In[402]:=",ExpressionUUID->"005a4c69-a61a-4404-970c-72ed98bc3cc9"],

