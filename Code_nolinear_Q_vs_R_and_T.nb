 CellLabel->"In[79]:=",ExpressionUUID->"9e08bce6-724b-49a3-aba1-7ef609617797"],

Cell["\<\
alphaTensor1={{a1xx,a1xy,0},{a1yx,a1yy,0},{0,0,0}};
alphaTensor2={{a2xx,a2xy,0},{a2yx,a2yy,0},{0,0,0}};\
\>", "Input",
 CellLabel->"In[83]:=",ExpressionUUID->"690e1bc7-acf6-4221-a051-d8c453b13bf0"],

