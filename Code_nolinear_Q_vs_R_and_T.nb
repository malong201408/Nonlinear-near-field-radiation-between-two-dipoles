Cell[CellGroupData[{

Cell["\<\
(* ---------------------------------------------------------------------------\
- *)
(*  OPTIONAL quick preview overlay (|Q_total| vs R for each T2 regime).       \
   *)
(*  Written as a PNG so it also works headless via wolframscript.  This is \
only  *)
(*  a sanity-check figure; the OriginLab CSVs above are the real deliverable. \
   *)
(* ---------------------------------------------------------------------------\
- *)
If[TrueQ[makePreviewPlot],
  Quiet@Check[
   Module[{absOf, curvesTot, curvesL, curvesNL, plt},
     absOf[data_] := Select[
        {#[[1]], Abs[Re[N[#[[2]]]]]} & /@ data,
        (r2LoA <= #[[1]] <= r2HiA) && NumericQ[#[[2]]] && #[[2]] > 0 &];
     curvesTot = absOf[sweepQ[#][\"QTot\"]] & /@ T2sweep;
     plt = ListLogLogPlot[curvesTot,
        Joined -> True, PlotMarkers -> {Automatic, 5},
        Frame -> True, Axes -> False, GridLines -> Automatic,
        FrameLabel -> {\"R  (Angstrom)\", \"|Q_total|  (eV/s)\"},
        PlotLegends -> Placed[
           ((\"T2 = \" <> ToString[#] <> \" K\") & /@ T2sweep), Right],
        PlotLabel -> \"Q vs R   (T1 = \" <> ToString[T1sweep] <> \" K)\",
        PlotRange -> {{10.^xLo, 10.^xHi}, Automatic},
        ImageSize -> 560];
     Export[FileNameJoin[{outDir, \"Q_vs_R_Tsweep_preview.png\"}], plt];
     Print[\"  preview figure -> Q_vs_R_Tsweep_preview.png\"];
   ],
   Print[\"  [note] preview PNG skipped (headless rasterization unavailable); \
\",
         \"use the CSV files in OriginLab.\"]]];\
\>", "Input",
 CellLabel->
  "In[407]:=",ExpressionUUID->"dcfd4039-7fd1-4658-9938-369e1b52522a"],

Cell[CellGroupData[{

Cell[BoxData["\<\"  preview figure -> Q_vs_R_Tsweep_preview.png\"\>"], "Print",
