Cell[CellGroupData[{

Cell["\<\
sweepQ = Association[];
Do[
  Module[{qlL, qnlL, qtotL, tSw},
   tSw = AbsoluteTiming[
     qlL  = Table[{N[r2*EffR2], hbar*om001^2*QL12T[r2, T1sweep, t2]},  {r2, \
r2List}];
     qnlL = Table[{N[r2*EffR2], hbar*om001^2*QNL12T[r2, T1sweep, t2]}, {r2, \
r2List}];
     qtotL = MapThread[{#1[[1]], #1[[2]] + #2[[2]]} &, {qlL, qnlL}];
   ][[1]];
   sweepQ[t2] = <|\"QL\" -> qlL, \"QNL\" -> qnlL, \"QTot\" -> qtotL|>;
   Print[\"  T2 = \", t2, \" K  done   (\", NumberForm[tSw, 4], \" s)\"];
  ],
  {t2, T2sweep}];\
\>", "Input",
 CellLabel->
  "In[400]:=",ExpressionUUID->"a0bb58fb-c0b4-4939-99d1-d5f19f6391ed"],

